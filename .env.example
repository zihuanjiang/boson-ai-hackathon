# Boson AI API key — create at https://www.boson.ai/workspace/api-key (format: bai-xxxx).
# Claim the free trial credit (and the hackathon Realtime credit) on that page first,
# otherwise every call fails with 429 insufficient_quota.
BOSON_API_KEY=

# Anthropic API key for the alignment analysis (Claude reads the documents and the discussion; Higgs still speaks).
# Separate billing from Boson. Real keys belong only in .env (gitignored) or the environment, never here.
ANTHROPIC_API_KEY=
# RELAY_ALIGNMENT=claude                          # claude (needs the key) | legacy (regex checks.yaml) | off
# RELAY_ALIGNMENT_MODEL=claude-opus-5-5           # measured against claude-sonnet-5-5 / claude-haiku-5-5: doc/gotchas.md
# RELAY_ALIGNMENT_EFFORT=low                      # low | medium | high (latency vs thoroughness)
# RELAY_ALIGNMENT_TIMEOUT_S=20                    # one analysis request; the meeting goes on without a late result
# RELAY_ALIGNMENT_MAX_TOKENS=4000                 # the structured result's output budget

# Optional overrides (defaults shown)
# BOSON_BASE_URL=https://api.boson.ai
# BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime
# BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview   # the default (newest model); higgs-realtime to go back

# Runtime (defaults shown; doc/architecture.md)
# RELAY_PACE=1.15                                 # > 1: each live talking point is asked to be shorter (brisker)
# RELAY_INPUT=                                    # voice (Zoom; scripts/zoom_bot.py sets it) | mic (a browser, Space)
# MIC_MODE=tap                                    # mic input: tap (Space opens one turn) | hold (hold Space to talk)
# RELAY_TEMPERATURE=                              # unset = server default (read the session.created ack)
# RELAY_FULL_SESSION_UPDATE=0                     # 1 = resend the full session config on every live turn
# RELAY_HOST=127.0.0.1
# RELAY_PORT=8000
